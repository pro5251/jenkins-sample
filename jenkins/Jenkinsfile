pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building backend and frontend...'
                dir('backend') {
                    sh 'dotnet build'
                }
                dir('frontend') {
                    sh 'npm install && npm run build'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                dir('backend') {
                    sh 'dotnet test'
                }
                dir('frontend') {
                    sh 'npm run test -- --run'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker images...'
                dir('docker') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                dir('docker') {
                    sh 'docker compose up -d'
                }
            }
        }
    }

    post {
        failure {
            echo 'Build failed! Sending notifications...'
        }
        success {
            echo 'Build succeeded!'
        }
    }
}
