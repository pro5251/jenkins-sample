# =============================================================
# CI/CD 環境變數設定範本
# 使用方式：複製此檔案為 .env 並填入實際值
#   cp .env.example .env
# 注意：.env 檔案已加入 .gitignore，請勿提交至版控系統
# =============================================================

# Jenkins 管理員密碼
JENKINS_ADMIN_PASSWORD=admin

# GitLab 使用者帳密（Jenkins 用於 Git Clone）
GITLAB_USER=root
GITLAB_PASSWORD=your-gitlab-password

# GitLab API Token（Jenkins 用於回報 Commit 建置狀態）
# 取得方式：GitLab → User Settings → Access Tokens → 建立 api scope Token
GITLAB_API_TOKEN=your-gitlab-api-token

# Docker Hub 帳密（Jenkins 用於推送映像）
# 若使用私有 Registry 請調整 Jenkinsfile 中的 registry URL
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-password


# MSSQL SA 密碼（應用服務使用）
# 規則：至少 8 字元，含大寫、小寫、數字及符號
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
